    {
      "id": "JOB-001",
      "category": "job_visa",
      "title": "Job or visa offer that asks you to pay or transfer money",
      "status": "active",
      "description": "The message offers a job, recruitment or work visa and asks for a fee, deposit or transfer. The UAE Government portal says the employer is responsible for recruitment expenses under the UAE Labour Law, and that a job offer should be issued through MOHRE.",
      "groups": [
        {
          "name": "job_offer",
          "any": [
            "job offer",
