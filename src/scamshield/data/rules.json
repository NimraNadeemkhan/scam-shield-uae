      "reviewed": "2026-11-22"
    },
    {
      "id": "DEL-003",
      "category": "delivery",
      "title": "Shipment message requesting a fee or payment with a link",
      "status": "active",
      "description": "The message ties a payment or fee to a shipment and includes a link. DHL lists payment requests as a fraud pattern and states that its only payment requests by email or SMS are for customs duties and taxes, so unsolicited fee requests should be verified through DHL support rather than the message.",
      "groups": [
        {
          "name": "shipment",
          "any": [
            "parcel",
            "parcels",
            "shipment",
            "package",
            "consignment",
            "delivery",
            "courier",
            "tracking",
            "شحنة",
            "شحنتك",
            "طرد",
            "توصيل"
          ]
        },
        {
          "name": "payment",
          "any": [
            "pay",
            "payment",
            "fee",
            "fees",
            "charge",
            "charges",
            "customs duty",
            "customs duties",
            "customs fee",
            "settle",
            "رسوم",
            "ادفع",
            "دفع",
            "سداد",
            "سدد"
          ]
        },
        {
          "name": "link",
          "has_url": true
        }
      ],
      "suppress_if_all_urls_official": true,
      "template_id": "delivery",
      "result": "verify",
      "source": {
        "title": "Fraud awareness",
        "publisher": "DHL Express UAE",
        "url": "https://www.dhl.com/ae-en/home/footer/fraud-awareness.html",
        "level": "primary",
        "published": null,
        "checked": "2026-11-22"
      },
      "reviewed": "2026-11-22"
    },
    {
      "id": "DEL-004",
      "category": "delivery",
      "title": "Shipment message linking to a lookalike of a courier or customs domain",
      "status": "active",
      "description": "The message mentions a shipment and links to a domain that contains a known courier or customs name but is not one of that organisation's published domains. DHL publishes its legitimate sender and link domains and warns of lookalike addresses.",
      "groups": [
        {
          "name": "shipment",
