    {
      "id": "BNK-001",
      "category": "banking",
      "title": "Request to send or confirm card, PIN, password or account details",
      "status": "active",
      "description": "The message asks you to send, enter or confirm card numbers, PINs, passwords, security codes or account numbers. Dubai Police advise against sharing account numbers, card numbers, passwords, personal identification codes or the security code on the back of a card.",
      "groups": [
        {
          "name": "request",
          "any": [
            "send",
            "share",
            "provide",
            "enter",
            "submit",
            "reply with",
            "confirm",
            "update",
            "verify",
            "give us",
            "ارسل",
            "ارسال",
            "شارك",
            "زود",
            "ادخل",
            "ادخال",
            "تأكيد",
            "تحديث",
            "تحقق"
          ]
        },
        {
          "name": "sensitive_detail",
          "any": [
            "card number",
            "card details",
            "cvv",
            "cvc",
            "pin",
            "password",
            "security code",
            "account number",
            "bank details",
            "account details",
            "رقم البطاقة",
            "رقم الحساب",
            "الرقم السري",
            "كلمة المرور",
            "كلمة السر",
            "رمز الأمان",
            "بيانات البطاقة",
            "بيانات الحساب",
            "بيانات البنك"
          ]
        }
      ],
      "suppress_if_any": [
        "never share",
        "do not share",
        "don't share",
        "never ask",
        "will never ask",
        "won't ask",
        "will not ask",
        "لن نطلب",
        "لا تشارك",
        "لن يطلب"
      ],
      "template_id": "banking",
      "result": "verify",
      "source": {
        "title": "CBUAE, UBF, Abu Dhabi Police and Dubai Police launch national fraud awareness campaign",
        "publisher": "Central Bank of the UAE",
        "url": "https://www.centralbank.ae/media/avkdwwpj/cbuae-ubf-abu-dhabi-police-and-dubai-police-join-forces-to-launch-uaes-first-national-fraud-awareness-campaign_1.pdf",
