{
  "version": "0.1.0",
  "rules": [
    {
      "id": "DEL-001",
      "category": "delivery",
      "title": "Shipment claim asking you to update or confirm details via a link",
      "status": "active",
      "description": "The message mentions a shipment, asks you to update or confirm information, and includes a link. Abu Dhabi Customs warns of fake SMS/iMessage messages impersonating the authority and shipping companies that claim a shipment and ask recipients to update information, with links that may be harmful.",
      "groups": [
        {
          "name": "shipment",
          "any": [
            "parcel",
            "parcels",
            "shipment",
            "package",
            "consignment",
            "delivery",
            "courier",
            "tracking",
            "شحنة",
            "شحنتك",
            "طرد",
            "توصيل"
          ]
        },
        {
          "name": "update_or_confirm",
          "any": [
            "update",
            "confirm",
            "verify",
            "validate",
            "reschedule",
            "تحديث",
            "تأكيد",
            "تحقق",
            "حدث بياناتك",
            "حدث معلوماتك"
          ]
        },
        {
          "name": "link",
          "has_url": true
        }
      ],
      "suppress_if_all_urls_official": true,
      "template_id": "delivery",
      "result": "verify",
      "source": {
        "title": "Abu Dhabi Customs warns against fraudulent text messages impersonating the authority",
        "publisher": "Abu Dhabi Customs",
        "url": "https://www.adcustoms.gov.ae/en/Media-Centre/News/Abu-Dhabi-Customs-warns-against-fraudulent-text-messages-impersonating-the-authority",
        "level": "primary",
        "published": "2026-03-10",
        "checked": "2026-11-22"
      },
      "reviewed": "2026-11-22"
    },
    {
      "id": "DEL-002",
      "category": "delivery",
      "title": "Shipment message with a shortened link",
      "status": "active",
      "description": "The message mentions a shipment and hides its destination behind a link shortener. DHL lists shortened links (for example bit.ly) in fake delivery SMS as a warning sign.",
      "groups": [
        {
          "name": "shipment",
          "any": [
            "parcel",
            "parcels",
